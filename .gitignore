# Drupal
/docroot/*.*
!/docroot/no_robots.txt
/docroot/core
/docroot/libraries
/docroot/modules/contrib
/docroot/themes/contrib
/docroot/profiles/contrib

/docroot/sites/*
!/docroot/sites/default
/docroot/sites/default/*
!/docroot/sites/default/settings.php
!/docroot/.well-known

/config/**/.htaccess
!/config/default/.htaccess

# Drush
/drush/contrib

# Compiled assets
/docroot/**/*.css
/docroot/**/*.js
!/docroot/**/*.es6.js
/docroot/**/*.map

# Project dependencies
/node_modules
/vendor

# Project test results
/tests/**/results
.phpunit.result.cache

# Lando / Local dev
/*.gz
/.lando.local.yml
/.gitattributes
/.env

# ACSF ops console app (deployment-scripts/); see .env.example.
/deployment-scripts/.env

# PHPStorm
/.idea
/private/
!/private/files/.gitkeep
!/private/files/.htaccess
