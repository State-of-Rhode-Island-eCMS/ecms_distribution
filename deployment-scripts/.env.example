# Copy this file to deployment-scripts/.env and fill in real values.
# deployment-scripts/.env is gitignored; never commit real credentials.
#
# Get your API key from the ACSF dashboard:
# Account Settings > API Key, e.g.
# https://www.riecms.acsitefactory.com/user/{uid}/api-key

ACSF_API_USER=

# A single key used for every environment, unless a more specific
# ACSF_API_KEY_{DEV,TEST,PROD} below is also set (which takes precedence
# for that environment). Keeping a separate, lower-privilege key here for
# stage and a distinct one only for prod is recommended.
ACSF_API_KEY=

#ACSF_API_KEY_DEV=
#ACSF_API_KEY_TEST=
#ACSF_API_KEY_PROD=

# Optional: request timeout in seconds. Defaults to 30.
#ACSF_REQUEST_TIMEOUT=30

# Optional override only — set this if a factory's API base URI doesn't
# follow the standard dev/test/prod hostname pattern baked into the tool.
#ACSF_FACTORY_URL=
